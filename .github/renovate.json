{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>jessehouwing/.github:renovate-config"],
  "minimumReleaseAge": "3 days",
  "azure-pipelines": {
    "enabled": true,
    "fileMatch": ["(^|/)azure-pipelines\\.ya?ml$", "(^|/)\\.github/pipelines/.*\\.ya?ml$"]
  },
  "npm": {
    "enabled": false
  },
  "github-actions": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Keep Node.js within the supported Actions and Azure Pipelines runtimes",
      "matchDatasources": ["node-version"],
      "allowedVersions": "/^v?(?:[0-9]|1[0-9]|2[0-4])(?:\\.|$)/"
    },
    {
      "matchDatasources": ["azure-pipelines-tasks"],
      "extractVersion": "^(?<version>\\d+)"
    }
  ]
}
