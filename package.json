{
  "name": "azdo-marketplace",
  "version": "6.0.0-alpha.1",
  "packageManager": "npm@11.6.1",
  "description": "AzDo Marketplace",
  "repository": {
    "type": "git",
    "url": "https://github.com/jessehouwing/azdo-marketplace.git"
  },
  "keywords": [
    "azure-devops",
    "azure-pipelines",
    "azure-devops-marketplace",
    "tfs",
    "azure-devops-server"
  ],
  "workspaces": [
    "packages/core",
    "packages/azdo-task",
    "packages/github-action"
  ],
  "scripts": {
    "initdev": "npm install --no-progress --force --no-update-notifier --no-fund",
    "build": "npm run build --workspaces --if-present",
    "build:clean": "npm run clean && npm run initdev && npm run build",
    "package:tasks": "tfx extension create --root . --output-path dist --manifest-globs vss-extension.json",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --no-coverage",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:validate-samples": "node Scripts/validate-doc-yaml-samples.mjs",
    "sync:action-inputs": "node Scripts/sync-action-inputs.mjs",
    "sync:action-inputs:check": "node Scripts/sync-action-inputs.mjs --check",
    "bundle:azdo": "node Scripts/bundle.mjs azdo",
    "bundle:actions": "node Scripts/bundle.mjs actions",
    "bundle": "npm run bundle:azdo && npm run bundle:actions",
    "bundle:frozen": "node Scripts/bundle.mjs all --frozen",
    "setup:windows:path": "powershell -NoProfile -ExecutionPolicy Bypass -File ./Scripts/setup-windows-path.ps1",
    "clean": "git clean -fdX"
  },
  "author": "Jesse Houwing",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jest": "^30.5.1",
    "js-yaml": "^5.5.0",
    "prettier": "^3.9.9",
    "rollup": "^4.64.7",
    "tfx-cli": "^0.24.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.64.7",
    "@rollup/rollup-win32-x64-gnu": "^4.64.7",
    "@rollup/rollup-win32-x64-msvc": "^4.64.7"
  },
  "overrides": {
    "msalv1": {
      "uuid": "^11.1.1"
    },
    "msalv2": {
      "uuid": "^11.1.1"
    },
    "msalv3": {
      "uuid": "^11.1.1"
    }
  }
}
